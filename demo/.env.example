# copy to demo/.env — never commit secrets
# Any OpenAI-compatible Chat Completions key. DeepSeek is optional.

# CIVIL_API_KEY=
# CIVIL_API_BASE=https://api.openai.com/v1
# CIVIL_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# CIVIL_PORT=8765
# CIVIL_JOB_ROOT=

# packing-agent sidecar (pick one)
# PACKING_AGENT_URL=http://127.0.0.1:8000
# PACKING_AGENT_ROOT=E:\ai比赛
