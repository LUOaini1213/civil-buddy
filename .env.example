# LLM 可选（Civil Buddy 工作台 + 装箱 llm_toolcall）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Civil Buddy 工作台
# CIVIL_PORT=8765
# 装箱 sidecar：默认同仓根目录；或另开网关
# PACKING_AGENT_URL=http://127.0.0.1:8000
# PACKING_AGENT_ROOT=

# Agent5 skjolber 服务（Spring Boot）
# 未配置时自动回退本地 1D 装载
SKJOLBER_URL=http://127.0.0.1:8080
SKJOLBER_TIMEOUT_MS=8000
