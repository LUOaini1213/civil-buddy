# LLM：OpenAI 兼容 Chat Completions。自带 Key，不必 DeepSeek。
# CIVIL_API_KEY=
# CIVIL_API_BASE=https://api.openai.com/v1
# CIVIL_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Civil Buddy 工作台
# CIVIL_PORT=8765
# 页面断开（锁屏 / 切任务 / 关页面）后，这一轮还能无人值守跑多少秒；超时由服务端停止。0 = 断开即取消
# CIVIL_DETACHED_TURN_SECONDS=600
# 装箱 sidecar：默认同仓根目录；或另开网关
# PACKING_AGENT_URL=http://127.0.0.1:8000
# PACKING_AGENT_ROOT=

# Agent5 skjolber 服务（Spring Boot）
# 未配置时自动回退本地 1D 装载
SKJOLBER_URL=http://127.0.0.1:8080
SKJOLBER_TIMEOUT_MS=8000
