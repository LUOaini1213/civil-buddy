    "reinforcement_triggers": [
      { "when": "piece_length_mm > 3000", "action": "纵向加强或铁架" },
      { "when": "piece_length_mm > 5000", "action": "专用超长架 + 多点支撑" },
      { "when": "piece_weight_kg > 200", "action": "底部托盘/横梁" },
      { "when": "piece_weight_kg > 500", "action": "加强底座 + 限位" },
      { "when": "box_gross_kg > 1000", "action": "优先铁箱/钢骨箱" },
      { "when": "box_gross_kg > 2000", "action": "必须铁箱 + 全项校核" },
      { "when": "many_slender_bars", "action": "内部支撑防窜动" }
    ]
  },

