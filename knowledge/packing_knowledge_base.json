  "structure": {
    "load_combination": {
      "formula": "Fd = G * gamma",
      "gamma_default": 1.8,
      "gamma_heavy_or_impact": [2.0, 2.2],
      "gamma_lift": [2.0, 2.5],
      "gamma_if_gross_over_2000kg": 2.2
