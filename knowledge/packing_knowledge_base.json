    "allowable_stress_mpa": {
      "softwood_bending": [8, 12],
      "softwood_compression": [6, 10],
      "hardwood_bending": [12, 16],
      "hardwood_compression": [10, 14],
      "q235_bending_design": [145, 160]
    },
    "working_stress_mpa": {
      "wood_fb": 10.0,
      "steel_fb": 150.0,
      "wood_floor_kg_per_m2": 800,
      "steel_floor_kg_per_m2": 2500
    },
    "deflection_limit_ratio": 200,
    "mandatory_checks": [
      "底板抗弯",
      "框架稳定性",
      "局部承压",
      "吊装点",
      "动态载荷系数"
