  {
    "id": "schema_valid_boxes",
    "description": "装箱结果字段齐全且无校验错误",
    "raw_input": "钢板 10件 30kg 1200x800x50",
    "container_type": "40HQ",
    "expect": {
      "min_boxes": 1,
      "require_box_fields": ["箱号", "箱型", "外尺寸_mm", "毛重_kg", "装载内容", "结构计算", "结构结论"],
      "max_errors": 0,
      "require_structure_calc": true
    }
  },
  {
