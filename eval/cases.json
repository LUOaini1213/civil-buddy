[
  {
    "id": "demo_fallback_3_materials",
    "description": "无结构化输入时回退演示材料，合箱后可装 40HQ，且含结构计算",
    "raw_input": "演示：远东新加坡陆路交通局办公楼钢结构件装箱拼柜",
    "container_type": "40HQ",
    "expect": {
      "min_boxes": 1,
      "max_boxes": 3,
      "min_materials": 3,
      "conclusion_contains_any": ["可以", "顺利", "较紧"],
      "must_not_overflow": true,
      "max_space_util_pct": 100,
      "min_trace_nodes": 6,
      "require_structure_calc": true
    }
  },
  {
    "id": "text_two_steel_items",
    "description": "两行文本材料 → 可合箱，输出结构计算",
    "raw_input": "H型钢 4件 85kg 3800x400x200\n钢梁 6件 55kg 4200x350x175",
    "container_type": "40HQ",
    "expect": {
      "min_boxes": 1,
      "max_boxes": 2,
      "min_materials": 2,
      "must_not_overflow": true,
      "conclusion_contains_any": ["可以"],
      "require_structure_calc": true
    }
  },
  {
    "id": "json_materials_inject",
    "description": "JSON 材料清单注入",
    "raw_input": "[{\"名称\":\"超长梁\",\"规格\":\"H600\",\"数量\":2,\"单重_kg\":200,\"外尺寸_mm\":{\"长\":5900,\"宽\":600,\"高\":300},\"备注\":\"\"}]",
    "container_type": "40HQ",
    "expect": {
      "min_boxes": 1,
      "max_boxes": 1,
      "must_have_risk_keyword_any": ["超长", "长度"],
      "must_not_overflow": true
    }
  },
  {
    "id": "overflow_many_long_boxes",
