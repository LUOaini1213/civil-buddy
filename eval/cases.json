      {"名称": "件A", "规格": "A", "数量": 1, "单重_kg": 100, "外尺寸_mm": {"长": 5800, "宽": 1000, "高": 1000}, "备注": ""},
      {"名称": "件B", "规格": "B", "数量": 1, "单重_kg": 100, "外尺寸_mm": {"长": 5800, "宽": 1000, "高": 1000}, "备注": ""},
      {"名称": "件C", "规格": "C", "数量": 1, "单重_kg": 100, "外尺寸_mm": {"长": 5800, "宽": 1000, "高": 1000}, "备注": ""}
