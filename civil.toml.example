# Copy to civil.toml or .civil-buddy/config.toml
# Same knobs as Codex: sandbox (what it may write) + approval (when to ask).

[civil]
sandbox = "workspace-write"   # read-only | workspace-write
approval = "on-request"       # untrusted | on-request | never
max_steps = 8
max_parallel = 4
# App Server: python -m packing_assistant.civil serve
# JSON-RPC on this harness. Not the openai/codex binary. No Cloud.

[workspace]
# job_root = "C:/Users/你/Documents/某工地"
# 生产数据目录不能当作业根：在环境变量 CIVIL_PROTECTED_ROOTS 里列出（默认为空）
